{
  "name": "pumpevakt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Oslo fuel-price Telegram bot + web page on Cloudflare Workers + D1",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "npm run build:web && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply pumpevakt --local",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "maplibre-gl": "5.24.0",
    "miniflare": "4.20260730.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "wrangler": "4.151.3"
  },
  "overrides": {
    "vite": "6.4.5"
  }
}

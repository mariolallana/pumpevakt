{
  "name": "pumpevakt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Oslo fuel-price Telegram bot on Cloudflare Workers + D1",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply pumpevakt --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260426.1",
    "miniflare": "4.20260426.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.86.0"
  },
  "overrides": {
    "vite": "6.4.5"
  }
}
